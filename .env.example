# MongoDB (optional). When set, all admin content and form data are stored in MongoDB with 30-day version history.
# Get a free cluster at https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB_NAME=womenrf

# Optional: Add your PayPal client ID to show the PayPal Donate button on the Donate page.
# Get it from https://developer.paypal.com/dashboard/applications/sandbox (sandbox) or production.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_client_id_here
