# MongoDB (optional). When set, all admin content and form data are stored in MongoDB with 30-day version history.
# Get a free cluster at https://www.mongodb.com/cloud/atlas
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# MONGODB_DB_NAME=******

# PayPal: Donate page (one-time donations, USD).
# Get from https://developer.paypal.com/dashboard/applications (Sandbox or Live).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_client_id_here
# PAYPAL_CLIENT_SECRET=your_secret_here   (server-side only; never expose in frontend)

# SMTP Email Configuration - For sending donation confirmations
# Common SMTP hosts:
# Gmail: smtp.gmail.com (port 587) - requires App Password if 2FA is enabled
# Outlook: smtp-mail.outlook.com (port 587)
# Office365: smtp.office365.com (port 587)
# cPanel/Custom: Usually mail.yourdomain.com (port 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@domain.com
# SMTP_PASSWORD=your_email_password
